# Copie este arquivo para .env na raiz do projeto. O servidor o carrega no
# arranque; variáveis já definidas no ambiente têm prioridade sobre o arquivo.

# Senha da área de admin. Sem ela, o registro de chegada fica desativado.
ADMIN_PASSWORD=troque-esta-senha

# Porta HTTP (padrão 3000).
PORT=3000

# Arquivo SQLite (padrão ./data/bolao.db).
DB_FILE=./data/bolao.db
